# .gitignore for MoodyFood Project

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
.venv/
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Streamlit
.streamlit/

# Database
*.db-journal
*.db-wal
*.db-shm

# Logs
logs/*.log
*.log

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.bak
*.backup

# Model files (if large)
models/*.h5
models/*.pb

# Data (if sensitive)
# database/*.db  # Uncomment if you don't want to commit database

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb_checkpoints

# Distribution / packaging
dist/
build/
*.egg-info/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Documentation build
docs/_build/
